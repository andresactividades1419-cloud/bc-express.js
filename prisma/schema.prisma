generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]

  @@map("clients")
}

model Event {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  category  String
  price     Float
  capacity  Int      @default(100)
  active    Boolean  @default(true)
  location  String
  date      DateTime
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}
